string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef fixture_id)
set(fixture "${FIXTURE_PARENT}/cli-fixture-${fixture_id}")
file(MAKE_DIRECTORY "${fixture}/nested")
file(WRITE "${fixture}/a.txt" "abc")
file(WRITE "${fixture}/nested/b.bin" "12345")
execute_process(COMMAND "${CLI}" scan "${fixture}" --format json
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE progress)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "scan failed: ${status}: ${progress}")
endif()
string(JSON bytes GET "${report}" logical_bytes)
string(JSON count GET "${report}" files)
string(JSON complete GET "${report}" complete)
if(NOT bytes EQUAL 8 OR NOT count EQUAL 2 OR NOT complete)
  message(FATAL_ERROR "Incorrect scan metrics: ${report}")
endif()
execute_process(COMMAND "${CLI}" largest "${fixture}" --format json --top 1 --extension .txt
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
string(JSON count LENGTH "${report}" largest_files)
string(JSON size GET "${report}" largest_files 0 logical_bytes)
if(NOT status EQUAL 0 OR NOT count EQUAL 1 OR NOT size EQUAL 3)
  message(FATAL_ERROR "Incorrect filter: ${report}")
endif()
execute_process(COMMAND "${CLI}" scan "${fixture}" --format csv
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
if(NOT status EQUAL 0 OR NOT report MATCHES "kind,path,logical_bytes")
  message(FATAL_ERROR "CSV export failed")
endif()
execute_process(COMMAND "${CLI}" scan "${fixture}/missing" --format json
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
string(JSON complete GET "${report}" complete)
if(NOT status EQUAL 1 OR complete)
  message(FATAL_ERROR "Missing root was not reported as incomplete")
endif()
execute_process(COMMAND "${CLI}" scan "${fixture}" --top -1 RESULT_VARIABLE status)
if(NOT status EQUAL 2)
  message(FATAL_ERROR "Invalid option did not return usage status")
endif()
file(WRITE "${fixture}/copy.txt" "abc")
execute_process(COMMAND "${CLI}" duplicates "${fixture}" --format json
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
string(JSON groups LENGTH "${report}" duplicates groups)
string(JSON verification GET "${report}" duplicates groups 0 verification)
if(NOT status EQUAL 0 OR NOT groups EQUAL 1 OR NOT verification STREQUAL "byte_verified")
  message(FATAL_ERROR "Incorrect duplicate results: ${report}")
endif()
file(MAKE_DIRECTORY "${fixture}/project/__pycache__")
file(WRITE "${fixture}/project/__pycache__/module.pyc" "bytecode")
execute_process(COMMAND "${CLI}" dev-cleanup "${fixture}" --dry-run --format json
  RESULT_VARIABLE status OUTPUT_VARIABLE report)
string(JSON candidates LENGTH "${report}" cleanup_candidates)
if(NOT status EQUAL 0 OR NOT candidates EQUAL 1 OR NOT EXISTS "${fixture}/project/__pycache__/module.pyc")
  message(FATAL_ERROR "Cleanup review failed or modified the fixture: ${report}")
endif()
set(before "${FIXTURE_PARENT}/snapshot-before-${fixture_id}.json")
set(after "${FIXTURE_PARENT}/snapshot-after-${fixture_id}.json")
execute_process(COMMAND "${CLI}" snapshot "${fixture}" --output "${before}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Snapshot creation failed")
endif()
execute_process(COMMAND "${CLI}" snapshot "${fixture}" --output "${before}" RESULT_VARIABLE status)
if(NOT status EQUAL 1)
  message(FATAL_ERROR "Snapshot overwrite was not refused")
endif()
file(WRITE "${fixture}/a.txt" "longer contents")
execute_process(COMMAND "${CLI}" snapshot "${fixture}" --output "${after}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Second snapshot creation failed")
endif()
execute_process(COMMAND "${CLI}" compare "${before}" "${after}" RESULT_VARIABLE status OUTPUT_VARIABLE report)
string(JSON changes LENGTH "${report}" changes)
if(NOT status EQUAL 0 OR NOT changes GREATER 0)
  message(FATAL_ERROR "Snapshot comparison failed: ${report}")
endif()
execute_process(COMMAND "${CLI}" scan "${fixture}" --format html RESULT_VARIABLE status OUTPUT_VARIABLE report)
if(NOT status EQUAL 0 OR NOT report MATCHES "<!doctype html>" OR NOT report MATCHES "Content-Security-Policy")
  message(FATAL_ERROR "HTML report export failed")
endif()
